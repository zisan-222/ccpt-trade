// Balance show / hide
const eyeBtn = document.getElementById("toggleBalance");
const balance = document.getElementById("balance");

let hidden = false;

if (eyeBtn && balance) {
    eyeBtn.addEventListener("click", () => {
        hidden = !hidden;

        if (hidden) {
            balance.textContent = "******";
            eyeBtn.classList.remove("fa-eye");
            eyeBtn.classList.add("fa-eye-slash");
        } else {
            balance.textContent = "$0.00";
            eyeBtn.classList.remove("fa-eye-slash");
            eyeBtn.classList.add("fa-eye");
        }
    });
}

// Deposit Button
const depositBtn = document.querySelector(".deposit-btn");

if (depositBtn) {
    depositBtn.addEventListener("click", () => {
        alert("Deposit page coming soon.");
    });
}

// Withdraw Button
const withdrawBtn = document.querySelector(".withdraw-btn");

if (withdrawBtn) {
    withdrawBtn.addEventListener("click", () => {
        alert("Withdraw page coming soon.");
    });
}

// Transfer Button
const transferBtn = document.querySelector(".transfer-btn");

if (transferBtn) {
    transferBtn.addEventListener("click", () => {
        alert("Transfer page coming soon.");
    });
}

// Quick Menu
document.querySelectorAll(".quick-item").forEach(item => {
    item.addEventListener("click", () => {
        const title = item.querySelector("span").innerText;
        alert(title + " feature coming soon.");
    });
});

// Bottom Navigation
document.querySelectorAll(".bottom-nav a").forEach(link => {
    link.addEventListener("click", function () {
        document.querySelectorAll(".bottom-nav a")
            .forEach(nav => nav.classList.remove("active"));

        this.classList.add("active");
    });
});
