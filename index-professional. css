/* =========================================================
   CPT Markets — Professional Login UI
   File: index-professional.css

   This file is UI-only.
   It does NOT change your login/register JavaScript logic.
   Link it from index.html with:
   <link rel="stylesheet" href="index-professional.css">
   ========================================================= */

:root {
  --bg-1: #020914;
  --bg-2: #061a31;
  --card: rgba(5, 22, 42, 0.88);
  --card-border: rgba(120, 170, 220, 0.16);
  --input: rgba(10, 43, 78, 0.92);
  --input-border: rgba(119, 174, 224, 0.20);
  --text: #f4f7fb;
  --muted: #91a4bc;
  --gold: #ffc400;
  --gold-2: #ffdd45;
  --gold-dark: #e8a900;
  --blue-link: #6d9dff;
  --danger: #ff5c70;
  --radius-xl: 30px;
  --radius-lg: 18px;
  --shadow: 0 28px 70px rgba(0, 0, 0, 0.48);
}

/* ---------- Base ---------- */

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html {
  min-height: 100%;
  background: var(--bg-1);
}

body {
  min-height: 100vh;
  margin: 0;
  padding: 24px 16px 34px;
  color: var(--text);
  font-family:
    Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background:
    radial-gradient(circle at 50% 18%, rgba(0, 87, 170, 0.22), transparent 34%),
    radial-gradient(circle at 15% 85%, rgba(255, 196, 0, 0.06), transparent 28%),
    linear-gradient(145deg, var(--bg-2) 0%, #031326 46%, var(--bg-1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-x: hidden;
}

/* subtle background lights */

body::before,
body::after {
  content: "";
  position: fixed;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(80px);
  opacity: 0.22;
  z-index: 0;
}

body::before {
  top: -150px;
  left: -120px;
  background: #0066c8;
}

body::after {
  right: -160px;
  bottom: -150px;
  background: #ffc400;
}

/* ---------- Main containers ---------- */

.container,
.login-container,
.login-page,
.auth-container,
.auth-card,
.login-card {
  position: relative;
  z-index: 1;
}

.container,
.login-container,
.login-page {
  width: 100%;
  max-width: 620px;
}

/* Card */

.card,
.login-card,
.auth-card,
.login-box,
.form-container {
  width: min(100%, 560px);
  margin: 0 auto;
  padding: 42px 38px 34px;
  border: 1px solid var(--card-border);
  border-radius: var(--radius-xl);
  background:
    linear-gradient(
      145deg,
      rgba(8, 31, 57, 0.96),
      rgba(2, 17, 34, 0.94)
    );
  box-shadow: var(--shadow);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* ---------- Logo / heading ---------- */

.logo,
.logo-text,
.brand,
.brand-name,
h1 {
  letter-spacing: -0.8px;
}

.logo {
  text-align: center;
  margin: 4px 0 6px;
  font-size: clamp(42px, 10vw, 64px);
  font-weight: 800;
  line-height: 1;
  color: #f8fbff;
}

.logo span,
.logo .gold,
.brand .gold,
.brand-name .gold {
  color: var(--gold);
  text-shadow:
    0 0 8px rgba(255, 196, 0, 0.55),
    0 0 28px rgba(255, 196, 0, 0.24);
}

.tagline,
.subtitle,
.logo-subtitle {
  margin: 12px 0 30px;
  text-align: center;
  color: #a8b8cd;
  font-size: 16px;
  letter-spacing: 0.38em;
  font-weight: 500;
}

/* ---------- Language / flag button ---------- */

.language,
.language-btn,
.lang-btn,
.flag-btn,
.language-selector {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 54px;
  height: 54px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.language:hover,
.language-btn:hover,
.lang-btn:hover,
.flag-btn:hover,
.language-selector:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35);
}

.language img,
.language-btn img,
.lang-btn img,
.flag-btn img,
.language-selector img {
  width: 34px;
  height: 34px;
  object-fit: cover;
  border-radius: 50%;
}

/* ---------- Form ---------- */

form {
  width: 100%;
}

label {
  display: block;
  margin: 0 0 9px;
  color: #eef3f9;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.form-group,
.input-group,
.field {
  margin-bottom: 21px;
}

/* Input wrapper */

.input-wrapper,
.input-box,
.input-group {
  position: relative;
}

/* Inputs */

input[type="text"],
input[type="email"],
input[type="password"],
input[type="number"],
input[type="tel"],
input[type="username"],
.input,
.form-control {
  width: 100%;
  min-height: 58px;
  padding: 0 52px 0 52px;
  border: 1px solid var(--input-border);
  border-radius: var(--radius-lg);
  outline: none;
  color: #f7faff;
  background:
    linear-gradient(
      180deg,
      rgba(13, 54, 94, 0.92),
      rgba(7, 39, 70, 0.92)
    );
  font-size: 16px;
  font-weight: 500;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    0 8px 24px rgba(0, 0, 0, 0.12);
  transition:
    border-color 0.22s ease,
    box-shadow 0.22s ease,
    transform 0.22s ease,
    background 0.22s ease;
}

input::placeholder,
.input::placeholder,
.form-control::placeholder {
  color: #8298b5;
}

input:focus,
.input:focus,
.form-control:focus {
  border-color: rgba(255, 196, 0, 0.72);
  background:
    linear-gradient(
      180deg,
      rgba(15, 61, 105, 0.98),
      rgba(8, 43, 77, 0.98)
    );
  box-shadow:
    0 0 0 4px rgba(255, 196, 0, 0.08),
    0 10px 28px rgba(0, 0, 0, 0.18);
}

/* Font Awesome / icon positions */

.input-icon,
.input-group > i,
.input-wrapper > i,
.icon-left {
  position: absolute;
  left: 19px;
  top: 50%;
  z-index: 2;
  transform: translateY(-50%);
  color: var(--gold);
  font-size: 20px;
  pointer-events: none;
}

.password-toggle,
.toggle-password,
.show-password,
.eye-icon,
.icon-right {
  position: absolute;
  right: 17px;
  top: 50%;
  z-index: 3;
  transform: translateY(-50%);
  border: 0;
  padding: 7px;
  color: var(--gold);
  background: transparent;
  cursor: pointer;
  font-size: 20px;
  transition: transform 0.18s ease, color 0.18s ease;
}

.password-toggle:hover,
.toggle-password:hover,
.show-password:hover,
.eye-icon:hover,
.icon-right:hover {
  color: var(--gold-2);
  transform: translateY(-50%) scale(1.08);
}

/* ---------- Main sign-in button ---------- */

button[type="submit"],
.login-btn,
.sign-in-btn,
.signin-btn,
.submit-btn,
.btn-primary,
#loginBtn,
#signInBtn {
  position: relative;
  width: 100%;
  min-height: 58px;
  margin-top: 8px;
  border: 0;
  border-radius: 17px;
  outline: none;
  color: #07111f;
  background:
    linear-gradient(
      135deg,
      #ffbf00 0%,
      #ffd11a 48%,
      #ffbf00 100%
    );
  box-shadow:
    0 12px 30px rgba(255, 190, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.42);
  font-size: 17px;
  font-weight: 800;
  letter-spacing: 0.01em;
  cursor: pointer;
  overflow: hidden;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    filter 0.2s ease;
}

button[type="submit"]::before,
.login-btn::before,
.sign-in-btn::before,
.signin-btn::before,
.submit-btn::before,
.btn-primary::before,
#loginBtn::before,
#signInBtn::before {
  content: "";
  position: absolute;
  top: 0;
  left: -120%;
  width: 80%;
  height: 100%;
  transform: skewX(-22deg);
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.32),
    transparent
  );
  transition: left 0.55s ease;
}

button[type="submit"]:hover,
.login-btn:hover,
.sign-in-btn:hover,
.signin-btn:hover,
.submit-btn:hover,
.btn-primary:hover,
#loginBtn:hover,
#signInBtn:hover {
  transform: translateY(-2px);
  filter: brightness(1.04);
  box-shadow:
    0 17px 36px rgba(255, 190, 0, 0.30),
    inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

button[type="submit"]:hover::before,
.login-btn:hover::before,
.sign-in-btn:hover::before,
.signin-btn:hover::before,
.submit-btn:hover::before,
.btn-primary:hover::before,
#loginBtn:hover::before,
#signInBtn:hover::before {
  left: 135%;
}

button[type="submit"]:active,
.login-btn:active,
.sign-in-btn:active,
.signin-btn:active,
.submit-btn:active,
.btn-primary:active,
#loginBtn:active,
#signInBtn:active {
  transform: scale(0.985);
}

/* ---------- Create account / forgot password ---------- */

.auth-links,
.login-links,
.bottom-links,
.form-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 23px;
}

.auth-links a,
.login-links a,
.bottom-links a,
.form-links a,
.create-account,
.register-link,
.forgot-password,
#registerLink,
#forgotPassword {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 42px;
  padding: 8px 12px;
  border: 1px solid transparent;
  border-radius: 12px;
  color: var(--blue-link);
  text-decoration: none;
  font-size: 14px;
  font-weight: 650;
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.auth-links a:first-child,
.login-links a:first-child,
.bottom-links a:first-child,
.form-links a:first-child,
.create-account,
.register-link,
#registerLink {
  color: #c7a0ff;
}

.auth-links a:hover,
.login-links a:hover,
.bottom-links a:hover,
.form-links a:hover,
.create-account:hover,
.register-link:hover,
.forgot-password:hover,
#registerLink:hover,
#forgotPassword:hover {
  transform: translateY(-1px);
  color: #ffffff;
  background: rgba(255, 255, 255, 0.055);
  border-color: rgba(255, 255, 255, 0.08);
}

/* ---------- Secondary buttons ---------- */

.btn-secondary,
.cancel-btn,
.back-btn,
.close-btn,
.secondary-button {
  min-height: 48px;
  padding: 0 18px;
  border: 1px solid rgba(136, 173, 210, 0.22);
  border-radius: 14px;
  color: #dce8f5;
  background: rgba(255, 255, 255, 0.045);
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-secondary:hover,
.cancel-btn:hover,
.back-btn:hover,
.close-btn:hover,
.secondary-button:hover {
  border-color: rgba(255, 196, 0, 0.42);
  color: var(--gold-2);
  background: rgba(255, 196, 0, 0.06);
}

/* ---------- Register / Forgot password forms ---------- */

.register-card,
.signup-card,
.forgot-card,
.reset-card {
  width: min(100%, 560px);
  margin: 0 auto;
  padding: 38px;
  border: 1px solid var(--card-border);
  border-radius: var(--radius-xl);
  background:
    linear-gradient(
      145deg,
      rgba(8, 31, 57, 0.97),
      rgba(2, 17, 34, 0.96)
    );
  box-shadow: var(--shadow);
}

.register-card h2,
.signup-card h2,
.forgot-card h2,
.reset-card h2 {
  margin: 0 0 8px;
  color: #ffffff;
  font-size: 27px;
  text-align: center;
}

.register-card p,
.signup-card p,
.forgot-card p,
.reset-card p {
  margin: 0 0 26px;
  color: var(--muted);
  line-height: 1.6;
  text-align: center;
}

/* ---------- Alerts / messages ---------- */

.error,
.error-message,
.login-error,
.alert-error {
  margin-top: 12px;
  padding: 12px 14px;
  border: 1px solid rgba(255, 92, 112, 0.22);
  border-radius: 13px;
  color: #ff9eaa;
  background: rgba(255, 92, 112, 0.07);
  font-size: 13px;
}

.success,
.success-message,
.alert-success {
  margin-top: 12px;
  padding: 12px 14px;
  border: 1px solid rgba(77, 214, 148, 0.22);
  border-radius: 13px;
  color: #8df0bf;
  background: rgba(77, 214, 148, 0.07);
  font-size: 13px;
}

/* ---------- Loading state ---------- */

button.loading,
.login-btn.loading,
.sign-in-btn.loading {
  pointer-events: none;
  opacity: 0.78;
}

button.loading::after,
.login-btn.loading::after,
.sign-in-btn.loading::after {
  content: "";
  display: inline-block;
  width: 17px;
  height: 17px;
  margin-left: 9px;
  vertical-align: -3px;
  border: 2px solid rgba(7, 17, 31, 0.28);
  border-top-color: #07111f;
  border-radius: 50%;
  animation: cpt-spin 0.7s linear infinite;
}

@keyframes cpt-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------- Mobile ---------- */

@media (max-width: 600px) {
  body {
    padding: 14px 12px 28px;
    align-items: center;
  }

  .card,
  .login-card,
  .auth-card,
  .login-box,
  .form-container,
  .register-card,
  .signup-card,
  .forgot-card,
  .reset-card {
    padding: 32px 22px 25px;
    border-radius: 26px;
  }

  .logo {
    font-size: 47px;
  }

  .tagline,
  .subtitle,
  .logo-subtitle {
    margin-bottom: 25px;
    font-size: 14px;
    letter-spacing: 0.30em;
  }

  input[type="text"],
  input[type="email"],
  input[type="password"],
  input[type="number"],
  input[type="tel"],
  input[type="username"],
  .input,
  .form-control {
    min-height: 56px;
    font-size: 15px;
  }

  button[type="submit"],
  .login-btn,
  .sign-in-btn,
  .signin-btn,
  .submit-btn,
  .btn-primary,
  #loginBtn,
  #signInBtn {
    min-height: 56px;
  }

  .auth-links,
  .login-links,
  .bottom-links,
  .form-links {
    gap: 8px;
  }

  .auth-links a,
  .login-links a,
  .bottom-links a,
  .form-links a {
    padding: 7px 8px;
    font-size: 13px;
  }
}

@media (max-width: 380px) {
  body {
    padding-left: 8px;
    padding-right: 8px;
  }

  .card,
  .login-card,
  .auth-card,
  .login-box,
  .form-container,
  .register-card,
  .signup-card,
  .forgot-card,
  .reset-card {
    padding-left: 17px;
    padding-right: 17px;
  }

  .logo {
    font-size: 41px;
  }

  .auth-links,
  .login-links,
  .bottom-links,
  .form-links {
    flex-direction: column;
    align-items: stretch;
  }

  .auth-links a,
  .login-links a,
  .bottom-links a,
  .form-links a {
    justify-content: center;
  }
}

/* ---------- Accessibility ---------- */

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 2px solid rgba(255, 196, 0, 0.82);
  outline-offset: 3px;
}

/* ---------- Reduced motion ---------- */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
